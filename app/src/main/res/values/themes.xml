<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme — Compose handles its own theming -->
    <style name="Theme.HabitGame" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Overlay theme for BlockOverlayActivity -->
    <style name="Theme.HabitGame.Overlay" parent="Theme.HabitGame">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
