<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <!-- Map tiles for the location picker -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Required on Android 14+ for the location foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Lets the app-lock picker see every app in the app drawer (Android 11+ hides them otherwise) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".HabitGameApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HabitGame">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.HabitGame">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share a song or album from a music app into today's journal -->
            <intent-filter android:label="Add to journal">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Block Overlay Activity -->
        <activity
            android:name=".domain.restriction.BlockOverlayActivity"
            android:exported="false"
            android:theme="@style/Theme.HabitGame.Overlay"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true" />

        <!-- Usage Monitor Foreground Service -->
        <service
            android:name=".domain.restriction.UsageMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="monitorAppUsage" />
        </service>

        <!-- Focus timer: keeps a focus session counting while HabitGame is closed -->
        <service
            android:name=".domain.focus.FocusTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="focusTimer" />
        </service>

        <!-- Location Tracking Foreground Service -->
        <service
            android:name=".domain.location.LocationTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- WorkManager: initialised by HabitGameApp so Hilt can inject into workers -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Home-screen widgets -->
        <receiver
            android:name=".widget.ChecklistWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_checklist_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_checklist" />
        </receiver>

        <receiver
            android:name=".widget.CharacterWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_character_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_character" />
        </receiver>

        <receiver
            android:name=".widget.BoardWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_board_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_board" />
        </receiver>

        <receiver
            android:name=".widget.SavingsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_savings_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_savings" />
        </receiver>

        <!-- "Done" button on task reminder notifications -->
        <receiver
            android:name=".domain.notification.TaskActionReceiver"
            android:exported="false" />

        <!-- Boot receiver to reschedule workers -->
        <receiver
            android:name=".domain.notification.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>


    </application>
</manifest>
